    "@types/react-native-web": "^0.19.2",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-preset-expo": "~56.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
