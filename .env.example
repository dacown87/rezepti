# Groq API (kostenlos, https://console.groq.com)
# Server-Fallback. Einzelne Extraktionsjobs können per BYOK `x-groq-key`
# oder JSON `apiKey` einen eigenen Groq-Key verwenden.
GROQ_API_KEY=gsk_...

# Optionale Modell-Overrides
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Ollama als lokaler LLM-Fallback (optional, kostenlos)
# Ollama starten: ollama serve
# Modell laden: ollama pull llama3.3:70b
# Dann hier eintragen:
# GROQ_BASE_URL=http://localhost:11434/v1
# GROQ_API_KEY=ollama  (Ollama ignoriert den Key)
# GROQ_TEXT_MODEL=llama3.3:70b

# Supabase (PostgreSQL + Auth) — https://supabase.com
#
# Env-Matrix fuer Multi-User Login First Slice:
# - Server-only: DATABASE_URL, STAGING_DATABASE_URL,
#   RECIPE_SOURCE_AUDIT_DATABASE_URL und alle Secret-/Service-Role-Keys.
# - Mobile-public: EXPO_PUBLIC_SUPABASE_URL und
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY oder EXPO_PUBLIC_SUPABASE_ANON_KEY.
#   Diese duerfen im Expo/Web-Client landen und werden nur mit User-JWT + RLS verwendet.
# - Auth-Onboarding auf Mobile/Web braucht zusaetzlich funktionierende Supabase
#   Redirect-URLs fuer den Expo-Scheme `recipedeck://account` sowie die Web-URL.
# - Staging-only: STAGING_DATABASE_URL, STAGING_SUPABASE_* und
#   Testuser-/Admin-Bootstrap-Werte.
#
# Kein service_role-, secret- oder Postgres-Passwort in mobile/, public/ oder
# NEXT_PUBLIC-/EXPO_PUBLIC-aehnlichen Client-Variablen eintragen.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# Legacy-Fallback, falls das Projekt noch keinen Publishable Key nutzt:
# SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# Legacy-kompatibel, falls noch kein Publishable Key verwendet wird:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
DATABASE_URL=postgresql://postgres:<password>@db.xxxx.supabase.co:5432/postgres
STAGING_DATABASE_URL=postgresql://postgres:<password>@db.xxxx-staging.supabase.co:5432/postgres
STAGING_SUPABASE_URL=https://xxxx-staging.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# Legacy-Fallback, falls das Staging-Projekt noch keinen Publishable Key nutzt:
# STAGING_SUPABASE_ANON_KEY=eyJ...
# Server-only. Wird nur fuer Admin-Bootstrap/Cleanup im RLS-Smoke verwendet.
STAGING_SUPABASE_SECRET_KEY=sb_secret_xxxx
# Legacy-Fallback, falls das Staging-Projekt noch service_role statt secret key nutzt:
# STAGING_SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Optional: read-only/audit DB URL for scripts/get-db-urls.ts.
# Falls leer, nutzt das Script DATABASE_URL.
RECIPE_SOURCE_AUDIT_DATABASE_URL=postgresql://postgres:<password>@db.xxxx.supabase.co:5432/postgres

# Multi-User Auth Bootstrap (Staging-only, Phase 0.5 Doku)
# Diese Werte sind Platzhalter fuer Runbook/Smokes und duerfen nicht in
# produktive Clients gelangen. Bis Bootstrap-Scripts existieren, werden
# Testnutzer im Supabase Dashboard oder per Admin-API manuell angelegt.
STAGING_AUTH_USER_EMAIL=user-a@example.test
STAGING_AUTH_USER_PASSWORD=change-me
STAGING_AUTH_ADMIN_EMAIL=admin@example.test
STAGING_AUTH_ADMIN_PASSWORD=change-me
STAGING_AUTH_HOUSEHOLD_SLUG=auth-smoke-household
# Staging-Smoke-Schutz: nur genau dieser Wert erlaubt den Cloud-Smoke.
SUPABASE_RLS_SMOKE_CONFIRM=rezepti-staging

# Server
PORT=3000

# Extraktions-Jobs (in-memory, src/job-manager.ts)
# MAX_CONCURRENT_JOBS ist ein SERVER-WEITES Budget, das sich ALLE Nutzer
# teilen. Bei Erreichen liefert die API 429 mit status="busy".
# MAX_CONCURRENT_JOBS=6
# MAX_CONCURRENT_JOBS_PER_USER begrenzt zusätzlich einen einzelnen Nutzer,
# damit eine Person nicht das gesamte Server-Budget belegen kann.
# MAX_CONCURRENT_JOBS_PER_USER=3
# JOB_CLEANUP_DAYS=7
# JOB_STALLED_AFTER_MINUTES=30
# POLL_INTERVAL_MS=2000

# ML-Fallback für Web-Scraping: wenn kein Rezept-Selektor trifft, werden
# relevante DOM-Blöcke (max. 10) nach Recipe-Keywords gescored und an das LLM übergeben.
# Standard: false (spart LLM-Kosten bei unbekannten Seiten).
# ENABLE_ML_FALLBACK=false

# Cookidoo (cookidoo.de) — optional, für Rezept-Import von cookidoo.de
# Trage hier deine Thermomix-/Cookidoo-Zugangsdaten ein.
# Die App nutzt den Vorwerk Mobile App API (OAuth2 ROPC), kein Scraping.
COOKIDOO_EMAIL=deine@email.de
COOKIDOO_PASSWORD=deinPasswort

# Verschlüsselung der in der DB gespeicherten Cookidoo-Zugangsdaten (Passwort + Session-Cookies),
# AES-256-GCM. 32 Byte, Base64-kodiert — erzeugen mit: openssl rand -base64 32
# Gehört in denselben Secret-Store wie BREVO_API_KEY (Northflank Runtime Secret), NICHT ins Repo.
# WICHTIG: Geht dieser Schlüssel verloren, sind alle gespeicherten Zugangsdaten unbrauchbar und
# jede:r Nutzer:in muss sie neu eingeben.
CREDENTIAL_ENCRYPTION_KEY=

# Facebook — optional, für Video-Import von facebook.com
# Cookies werden als Netscape-Format in data/facebook-cookies.txt erwartet.
# Siehe data/facebook-cookies.txt.example für das Format.
# Cookies können mit der Browser-Extension "Get cookies.txt LOCALLY" exportiert werden.
# Pfad: data/facebook-cookies.txt (wird automatisch von der App gelesen)

# Web Push (PWA notifications). Generate once: npx web-push generate-vapid-keys
# WICHTIG: VAPID_PUBLIC_KEY und EXPO_PUBLIC_VAPID_PUBLIC_KEY MUESSEN identisch sein
# (einmal generieren, zweimal eintragen). EXPO_PUBLIC_* wird beim `build:mobile`
# ins Bundle gebacken — nach Aenderung neu bauen + neu deployen.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rezepti.app
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Recipe-Invite E-Mail-Versand (server-only, optional)
# Ohne diese Werte erstellt die API weiter Invites und gibt einen manuellen
# Link zurueck (`delivery.status=skipped`).
# RECIPE_INVITE_EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# Absender ist die in Brevo verifizierte Einzeladresse recipedeckapp@gmail.com.
# Das Projekt besitzt keine eigene Maildomain (siehe docs/PROJECT_LEARNINGS.md).
# RECIPE_INVITE_EMAIL_FROM=RecipeDeck <recipedeckapp@gmail.com>
# RECIPE_INVITE_EMAIL_REPLY_TO=recipedeckapp@gmail.com
# Oeffentliche Basis-URL fuer Links in Invite-Mails. Wenn leer, nutzt die API
# den Request-Origin.
# RECIPE_INVITE_BASE_URL=https://p01--rezepti-app--2s7hvlwm5zc5.code.run

# Gmail Production Monitor (server-only, internal operator mailbox)
# Bootstrap locally with the downloaded *Desktop* OAuth client JSON. Do not
# configure a filesystem path on Northflank: Production uses only the four
# runtime secrets below.
# GMAIL_OAUTH_CLIENT_FILE=data/client_secret_<desktop-client>.json
# GMAIL_OAUTH_TOKEN_FILE=data/gmail-oauth-token.json
# GMAIL_OAUTH_CLIENT_ID=...
# GMAIL_OAUTH_CLIENT_SECRET=...
# GMAIL_OAUTH_REFRESH_TOKEN=...
# GMAIL_MAILBOX=recipedeckapp@gmail.com
# Required only for the controlled self-sending probe command.
# GMAIL_BREVO_PROBE_ENABLED=false
